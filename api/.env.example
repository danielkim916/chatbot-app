LITELLM_ENDPOINT=https://api.jawon.kim
LITELLM_API_KEY=your-litellm-api-key-here
LITELLM_MODEL=GPT 5.6 Sol:gpt-5.6-sol;GPT 5.6 Luna:gpt-5.6-luna;GPT 5.6 Terra:gpt-5.6-terra;Claude Opus 4.8:claude-opus-4.8
HOST=127.0.0.1
PORT=3001
CHAT_ORIGIN=http://localhost:3000
WEB_SEARCH_ENABLED=true
CHAT_DAILY_LIMIT=300
SEARCH_DAILY_LIMIT=80
CHAT_PER_MINUTE=10
CHAT_CONCURRENCY=3
CHAT_TIMEOUT_MS=120000
# In development, budget state defaults to ~/.local/state/chatbot-api/budget.json.
# Production systemd sets CHAT_STATE_FILE=/var/lib/chatbot-api/budget.json.
